        } else if (groupe.equals("FIRST")) {

            offre(s, "First premium",
                    "#111*1*4*5*" + n + "*2*1#");

            offre(s, "First premium+",
                    "#111*1*4*5*" + n + "*2*2#");

            offre(s, "Promo first prestige 15Go",
                    "#111*1*4*5*" + n + "*2*3#");

            offre(s, "First royal",
                    "#111*1*4*5*" + n + "*2*4#");

        } else {

            offre(s, "YELOW100",
                    "#111*1*4*5*" + n + "*3*1#");

            offre(s, "YELOW SMS",
                    "#111*1*4*5*" + n + "*3*2#");

            offre(s, "YELOW 500",
                    "#111*1*4*5*" + n + "*3*3#");

            offre(s, "YELOW 1000",
