    private String construireResumeAujourdhui() {

        JSONArray array =
                chargerTransactionsSms();

        String today =
                new java.text.SimpleDateFormat(
                        "dd/MM/yy",
                        Locale.getDefault())
                        .format(
                                new java.util.Date());

        int operations = 0;
        long total = 0;
        long frais = 0;
        long bonus = 0;

        for (int i = 0;
             i < array.length();
             i++) {

            JSONObject o =
                    array.optJSONObject(i);

            if (o == null) {
                continue;
            }

            String date =
                    o.optString("date", "");

            if (!today.equals(date)) {
                continue;
            }

            operations++;

            total +=
                    o.optLong("montant", 0);

            frais +=
                    o.optLong("frais", 0);

            bonus +=
                    o.optLong("bonus", 0);
        }

        return
                "📅 Date : " + today + "\n\n" +
                "🔢 Opérations : " + operations + "\n" +
                "💵 Montants : " + formatAr(total) + " Ar\n" +
                "💰 Frais : " + formatAr(frais) + " Ar\n" +
                "🎁 Bonus : " + formatAr(bonus) + " Ar";
    }


    private void afficherHistoriqueSmsPro(
            TextView resultat,
            String recherche,
            String filtre) {

        try {

            JSONArray array =
                    chargerTransactionsSms();

            String query =
                    recherche == null
                            ? ""
                            : recherche.trim()
                                .toLowerCase(Locale.ROOT);

            StringBuilder s =
                    new StringBuilder();

            int count = 0;

            for (int i = 0;
                 i < array.length();
                 i++) {

                JSONObject o =
                        array.optJSONObject(i);

                if (o == null) {
                    continue;
                }

                long montant =
                        o.optLong("montant", 0);

                long frais =
                        o.optLong("frais", 0);

                long bonus =
                        o.optLong("bonus", 0);

                long solde =
                        o.optLong("solde", 0);

                boolean avecFrais =
                        frais > 0;

                if ("AVEC_FRAIS".equals(filtre)
                        && !avecFrais) {
                    continue;
                }

                if ("SANS_FRAIS".equals(filtre)
                        && avecFrais) {
                    continue;
                }

                String type =
                        o.optString("type", "");

                String operateur =
                        o.optString(
                                "operateur",
                                "M'VOLA / YAS");

                String nom =
                        o.optString("nom", "");

                String numero =
                        o.optString("numero", "");

                String reference =
                        o.optString(
                                "reference",
                                "");

                String raison =
                        o.optString(
                                "raison",
                                "");

                String date =
                        o.optString(
                                "date",
                                "");

                String heure =
                        o.optString(
                                "heure",
                                "");

                String original =
                        o.optString(
                                "message_original",
                                o.optString(
                                        "smsOriginal",
                                        ""));

                String searchable =
                        (
                                type + " " +
                                operateur + " " +
                                nom + " " +
                                numero + " " +
                                reference + " " +
                                raison + " " +
                                original
                        ).toLowerCase(
                                Locale.ROOT);

                if (!query.isEmpty()
                        && !searchable.contains(query)) {
                    continue;
                }

                s.append(
                        "━━━━━━━━━━━━━━━━━━━━\n");

                s.append("📩 ")
                        .append(type)
                        .append("\n");

                s.append("📡 Opérateur : ")
                        .append(operateur)
                        .append("\n");

                if (!nom.isEmpty()) {

                    s.append("👤 Client : ")
                            .append(nom)
                            .append("\n");
                }

                if (!numero.isEmpty()) {

                    s.append("📱 Téléphone : ")
                            .append(numero)
                            .append("\n");
                }

                s.append("💵 Montant : ")
                        .append(formatAr(montant))
                        .append(" Ar\n");

                s.append("💰 Frais : ")
                        .append(formatAr(frais))
                        .append(" Ar\n");

                s.append("🎁 Bonus : ")
                        .append(formatAr(bonus))
                        .append(" Ar\n");

                s.append("💳 Solde : ")
                        .append(formatAr(solde))
                        .append(" Ar\n");

                if (!reference.isEmpty()) {

                    s.append("🔖 Référence : ")
                            .append(reference)
                            .append("\n");
                }

                if (!raison.isEmpty()) {

                    s.append("📝 Raison : ")
                            .append(raison)
                            .append("\n");
                }

                if (!date.isEmpty()
                        || !heure.isEmpty()) {

                    s.append("🕘 Date : ")
                            .append(date)
                            .append(" ")
                            .append(heure)
                            .append("\n");
                }

                if (!original.isEmpty()) {

                    s.append(
                            "📜 Message original :\n")
                            .append(original)
                            .append("\n");
                }

                Button dummy = null;

                s.append("\n");

                count++;

                if (count >= 100) {
                    break;
                }
            }

            if (count == 0) {

                resultat.setText(
                        query.isEmpty()
                                ? "Aucune transaction automatique."
                                : "Aucune transaction trouvée pour : "
                                    + recherche);

            } else {

                s.insert(
                        0,
                        "📊 " +
                        count +
                        " transaction(s)\n\n");

                resultat.setText(
                        s.toString());
            }

        } catch (Exception e) {

            resultat.setText(
                    "❌ Impossible de lire l'historique.");

            e.printStackTrace();
        }
    }


