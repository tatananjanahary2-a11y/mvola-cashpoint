        if (requestCode == REQUEST_CALL) {

            if (grantResults.length > 0 &&
                    grantResults[0] ==
                    PackageManager.PERMISSION_GRANTED) {

                toast(
                        "Permission téléphone accordée. Relance l'opération.");
            } else {

                toast(
                        "Permission téléphone refusée.");
            }
        }
    }

