                requestCode,
                permissions,
                grantResults);

        if (requestCode == REQUEST_CONTACTS) {

            if (grantResults.length > 0 &&
                    grantResults[0] ==
                    PackageManager.PERMISSION_GRANTED) {

                showContacts();
            } else {

                toast(
                        "Permission Contacts refusée.");
