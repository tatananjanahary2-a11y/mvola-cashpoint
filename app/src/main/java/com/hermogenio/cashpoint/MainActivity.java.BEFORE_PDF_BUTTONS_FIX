    private int trouverOperateurIndex(
            int montant) {

        for (int i = 0;
             i < fraisOperateur.length;
             i++) {

            int[] r =
                    fraisOperateur[i];

            if (montant >= r[0] &&
                    montant <= r[1]) {

                return i;
            }
        }

        return -1;
    }

