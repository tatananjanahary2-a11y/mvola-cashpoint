    @Override
    protected void onActivityResult(
            int requestCode,
            int resultCode,
            Intent data) {

        super.onActivityResult(
                requestCode,
                resultCode,
                data);

        if (requestCode != REQUEST_SAVE_PDF) {
            return;
        }

        if (resultCode != RESULT_OK
                || data == null
                || data.getData() == null) {

            toast("Sauvegarde PDF annulée.");
            return;
        }

        Uri uri = data.getData();

        if (pendingPdfBytes == null) {
            toast("PDF tsy misy.");
            return;
        }

        try {

            getContentResolver()
                    .openOutputStream(uri);

            java.io.OutputStream out =
                    getContentResolver()
                            .openOutputStream(uri);

            if (out == null) {
                toast("Impossible d'écrire le PDF.");
                return;
            }

            out.write(pendingPdfBytes);
            out.flush();
            out.close();

            lastSavedPdfUri = uri;

            if (pendingIsRecuClient) {
                lastSavedRecuClientUri = uri;
                pendingIsRecuClient = false;
            }

            try {
                getContentResolver()
                        .takePersistableUriPermission(
                                uri,
                                Intent.FLAG_GRANT_READ_URI_PERMISSION
                                        | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
            } catch (Exception ignored) {
            }

            toast(
                    "✅ PDF enregistré\n" +
                    pendingPdfName);

            pendingPdfBytes = null;

        } catch (Exception e) {

            e.printStackTrace();

            toast(
                    "❌ Erreur sauvegarde PDF : " +
                    e.getMessage());
        }
    }

