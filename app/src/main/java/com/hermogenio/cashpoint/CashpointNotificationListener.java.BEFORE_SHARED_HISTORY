package com.hermogenio.cashpoint;

import android.app.Notification;
import android.content.SharedPreferences;
import android.os.Build;
import android.service.notification.NotificationListenerService;
import android.service.notification.StatusBarNotification;

import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Locale;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class CashpointNotificationListener
        extends NotificationListenerService {

    private static final String PREFS =
            "CASHPOINT_NOTIFICATION_HISTORY";

    private static final String KEY_HISTORY =
            "transactions";

    @Override
    public void onNotificationPosted(
            StatusBarNotification sbn) {

        if (sbn == null) {
            return;
        }

        Notification notification =
                sbn.getNotification();

        if (notification == null ||
                notification.extras == null) {
            return;
        }

        CharSequence title =
                notification.extras.getCharSequence(
                        Notification.EXTRA_TITLE);

        CharSequence text =
                notification.extras.getCharSequence(
                        Notification.EXTRA_TEXT);

        String titre =
                title == null ? "" : title.toString();

        String message =
                text == null ? "" : text.toString();

        if (message.trim().isEmpty()) {
            return;
        }

        /*
         * On ne traite que les notifications
         * susceptibles de contenir des opérations
         * CASH / MOBILE MONEY.
         */
        String source =
                titre + " " + message;

        String lower =
                source.toLowerCase(Locale.US);

        if (!lower.contains("mvola") &&
                !lower.contains("yas") &&
                !lower.contains("envoye") &&
                !lower.contains("recu") &&
                !lower.contains("achat de credit")) {

            return;
        }

        Transaction tx =
                parser(message);

        if (tx == null) {
            return;
        }

        enregistrer(tx);
    }

    private Transaction parser(
            String message) {

        Transaction tx =
                new Transaction();

        tx.messageOriginal =
                message;

        /*
         * --------------------------------------------------
         * REFERENCE
         * --------------------------------------------------
         */
        tx.reference =
                match(
                        message,
                        "(?i)Ref\\s*:\\s*([0-9]+)");

        /*
         * --------------------------------------------------
         * MONTANT
         * --------------------------------------------------
         */
        String montant =
                match(
                        message,
                        "(?i)([0-9][0-9\\s]*)\\s*Ar");

        tx.montant =
                normalizeNumber(montant);

        /*
         * --------------------------------------------------
         * FRAIS
         * --------------------------------------------------
         */
        String frais =
                match(
                        message,
                        "(?i)Frais\\s*:\\s*([0-9][0-9\\s]*)\\s*Ar");

        tx.frais =
                normalizeNumber(frais);

        /*
         * --------------------------------------------------
         * BONUS
         * --------------------------------------------------
         */
        String bonus =
                match(
                        message,
                        "(?i)Bonus\\s*:\\s*([0-9][0-9\\s]*)\\s*Ar?");

        tx.bonus =
                normalizeNumber(bonus);

        /*
         * --------------------------------------------------
         * SOLDE
         * --------------------------------------------------
         */
        String solde =
                match(
                        message,
                        "(?i)Solde(?:\\s+MVola)?\\s*:\\s*([0-9][0-9\\s]*)\\s*Ar");

        tx.solde =
                normalizeNumber(solde);

        /*
         * --------------------------------------------------
         * TRANSFERT ENVOYE
         * Exemple:
         * 10 275 Ar envoye a Berthine 0388228567
         * --------------------------------------------------
         */
        Pattern envoyePattern =
                Pattern.compile(
                        "(?i)^\\s*([0-9][0-9\\s]*)\\s*Ar\\s+envoy[eé]\\s+a\\s+(.+?)\\s+(0[0-9]{9})\\s+le\\s+([0-9/]+)\\s+a\\s+([0-9:]+)");

        Matcher envoye =
                envoyePattern.matcher(message);

        if (envoye.find()) {

            tx.type =
                    "TRANSFERT ENVOYÉ";

            tx.montant =
                    normalizeNumber(envoye.group(1));

            tx.nom =
                    envoye.group(2).trim();

            tx.numero =
                    envoye.group(3);

            tx.date =
                    envoye.group(4);

            tx.heure =
                    envoye.group(5);

            tx.raison =
                    match(
                            message,
                            "(?i)Raison\\s*:\\s*([^\\.]+)");

            return tx;
        }

        /*
         * --------------------------------------------------
         * CREDIT YAS
         * --------------------------------------------------
         */
        Pattern creditPattern =
                Pattern.compile(
                        "(?i)Achat\\s+de\\s+credit\\s+YAS\\s+reussi\\s*:\\s*([0-9][0-9\\s]*)\\s*Ar\\s+pour\\s+(0[0-9]{9})");

        Matcher credit =
                creditPattern.matcher(message);

        if (credit.find()) {

            tx.type =
                    "ACHAT CRÉDIT";

            tx.montant =
                    normalizeNumber(credit.group(1));

            tx.numero =
                    credit.group(2);

            return tx;
        }

        /*
         * --------------------------------------------------
         * TRANSFERT REÇU
         * Exemple:
         * 50 000 Ar recu de Richard 0347071955
         * --------------------------------------------------
         */
        Pattern recuPattern =
                Pattern.compile(
                        "(?i)^\\s*([0-9][0-9\\s]*)\\s*Ar\\s+re[cç]u\\s+de\\s+(.+?)\\s+(0[0-9]{9})\\s+le\\s+([0-9/]+)\\s+a\\s+([0-9:]+)");

        Matcher recu =
                recuPattern.matcher(message);

        if (recu.find()) {

            tx.type =
                    "TRANSFERT REÇU";

            tx.montant =
                    normalizeNumber(recu.group(1));

            tx.nom =
                    recu.group(2).trim();

            tx.numero =
                    recu.group(3);

            tx.date =
                    recu.group(4);

            tx.heure =
                    recu.group(5);

            return tx;
        }

        return null;
    }

    private String match(
            String text,
            String regex) {

        try {

            Matcher matcher =
                    Pattern.compile(regex)
                            .matcher(text);

            if (matcher.find()) {
                return matcher.group(1);
            }

        } catch (Exception ignored) {
        }

        return "";
    }

    private String normalizeNumber(
            String value) {

        if (value == null ||
                value.trim().isEmpty()) {

            return "";
        }

        return value
                .replace(" ", "")
                .replace(".", "")
                .trim();
    }

    private void enregistrer(
            Transaction tx) {

        SharedPreferences prefs =
                getSharedPreferences(
                        PREFS,
                        MODE_PRIVATE);

        String old =
                prefs.getString(
                        KEY_HISTORY,
                        "[]");

        try {

            org.json.JSONArray array =
                    new org.json.JSONArray(old);

            /*
             * REF = identifiant anti-doublon.
             */
            if (!tx.reference.isEmpty()) {

                for (int i = 0;
                        i < array.length();
                        i++) {

                    org.json.JSONObject oldTx =
                            array.getJSONObject(i);

                    if (tx.reference.equals(
                            oldTx.optString("reference"))) {

                        return;
                    }
                }
            }

            org.json.JSONObject obj =
                    new org.json.JSONObject();

            obj.put("type", tx.type);
            obj.put("nom", tx.nom);
            obj.put("numero", tx.numero);
            obj.put("montant", tx.montant);
            obj.put("frais", tx.frais);
            obj.put("bonus", tx.bonus);
            obj.put("solde", tx.solde);
            obj.put("reference", tx.reference);
            obj.put("date", tx.date);
            obj.put("heure", tx.heure);
            obj.put("raison", tx.raison);
            obj.put("message_original",
                    tx.messageOriginal);

            obj.put(
                    "date_reception",
                    new SimpleDateFormat(
                            "dd/MM/yyyy HH:mm:ss",
                            Locale.US)
                            .format(new Date()));

            array.put(obj);

            prefs.edit()
                    .putString(
                            KEY_HISTORY,
                            array.toString())
                    .apply();

        } catch (Exception ignored) {
        }
    }

    private static class Transaction {

        String type = "";
        String nom = "";
        String numero = "";
        String montant = "";
        String frais = "";
        String bonus = "";
        String solde = "";
        String reference = "";
        String date = "";
        String heure = "";
        String raison = "";
        String messageOriginal = "";
    }
}
